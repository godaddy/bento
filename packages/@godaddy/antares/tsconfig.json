{
  "extends": "../../../configs/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@godaddy/antares": ["./index.ts"],
      "@godaddy/antares/*": ["./exports/*.ts"],
      "#components/*": [
        "./components/*/src/index.tsx",
        "./components/chart/types.ts"
      ],
      "#test/*": ["./test/*"],
      "#types/*": ["./types/*"],
      "#utils/*": ["./utils/*"]
    }
  },
  "include": ["index.ts", "exports", "components", "utils", "test", "types"],
  "exclude": ["node_modules", "dist"]
}
